# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Python bytecode from the tools/ developer scripts
__pycache__/
*.pyc

# Deep Neural Network Models
*.pt
*.onnx
# Weights of models too large for the 2GB protobuf limit live in a sidecar
# next to the .onnx graph (unet_*.onnx.data is ~3.4GB each).
*.onnx.data
# Anchored: an unanchored pattern also matches source directories named
# Models, which git ignores case-insensitively on Windows.
/models/

# Executables
*.exe
*.out
*.app

# Releases
*.zip

# Build directories
build*
dist*
# ...but the build-system reference doc is not a build directory
!docs/reference/build.md
!OBJ-loader
!.github/
!.github/**
!resources/models/*/*.obj

# Third Party
!thirdparty/lua/*.lib
!thirdparty/lua/*.dll

# Auto-downloaded Dependencies
deps

#vscode
.vs
.vscode/*
!.vscode/launch.json
.claude

#Mikan
imgui.ini
MikanXR.log
!src/Object

#MikanUI
src/MikanUI/node_modules
src/MikanUI/resources/js
src/MikanUI/resources/images
src/MikanUI/resources/index.html
src/MikanUI/resources/css

#Tools
!tools/*/*.exe

# Language Bindings temp files
bindings/csharp/*.bat
bindings/typescript/node_modules
bindings/typescript/package-lock.json
*.log
