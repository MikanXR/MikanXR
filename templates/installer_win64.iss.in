; Inno Setup script for the MikanXR Win64 release installer.
; Configured by cmake/Installer.cmake, which fills in the APP_ placeholders and invokes ISCC.
; The payload is the installed application tree, so INSTALL has to run before CREATE_INSTALLER.

[Setup]
; AppId uniquely identifies MikanXR to the Windows uninstall database. Never reuse it for
; another application, and never change it or upgrades will install side by side.
AppId={{652BEB8A-043B-4A37-9FF0-297F35E70ACA}
AppName=MikanXR
AppVersion=${APP_VERSION}
AppVerName=MikanXR ${APP_VERSION}
AppPublisher=Brendan Walker
AppPublisherURL=https://github.com/brendanwalker/MikanXR
AppSupportURL=https://github.com/brendanwalker/MikanXR/issues
AppUpdatesURL=https://github.com/brendanwalker/MikanXR/releases
DefaultDirName={autopf}\MikanXR
DefaultGroupName=MikanXR
LicenseFile=${APP_LICENSE_FILE}
OutputDir=${APP_OUTPUT_DIR}
OutputBaseFilename=Mikan_${APP_VERSION}_Win64_Setup
Compression=lzma
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; NOTE: Don't use "Flags: ignoreversion" on any shared system files
Source: "${APP_PAYLOAD_DIR}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Mikan installs flat, so the editor sits at the root of the install folder
Name: "{group}\MikanXR"; Filename: "{app}\Mikan.exe"
Name: "{group}\{cm:UninstallProgram,MikanXR}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\MikanXR"; Filename: "{app}\Mikan.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Mikan.exe"; Description: "Launch MikanXR"; Flags: nowait postinstall skipifsilent
